# Synapse geometry module — Bazel configuration
# Windows platform config (required by user global .bazelrc)

# C++20 is required by @aether. aether's own .bazelrc sets these, but
# .bazelrc is NOT propagated across Bzlmod module boundaries, so we
# must replicate the essential flags here for all targets (including
# external deps like @aether//math).
build:windows --cxxopt=/std:c++20
build:windows --host_cxxopt=/std:c++20
build:windows --cxxopt=/Zc:__cplusplus
build:windows --host_cxxopt=/Zc:__cplusplus
build:windows --cxxopt=/utf-8
build:windows --host_cxxopt=/utf-8
build:windows --cxxopt=/permissive-
build:windows --host_cxxopt=/permissive-
build:windows --compiler=msvc-cl
