# ─────────────────────────────────────────────────────────────────────
# Synapse Native Geometry Kernel — Bazel Configuration
# ─────────────────────────────────────────────────────────────────────

# 0. Shared DervGen C++20 strict baseline (when sibling all-overview is present)
try-import %workspace%/../../../all-overview/devenv-skills/templates/bazel/cpp-common.bazelrc

# 1. Bzlmod Registry & Platform Auto-Detection
common --registry=https://bcr.bazel.build
common --enable_platform_specific_config

# 2. C++20 Standard (propagated across Bzlmod boundaries for @aether//math)
build:macos --cxxopt=-std=c++20
build:macos --host_cxxopt=-std=c++20
build:linux --cxxopt=-std=c++20
build:linux --host_cxxopt=-std=c++20

# Windows: MSVC C++20 strict compliance
build:windows --cxxopt=/std:c++20
build:windows --host_cxxopt=/std:c++20
build:windows --cxxopt=/Zc:__cplusplus
build:windows --host_cxxopt=/Zc:__cplusplus
build:windows --cxxopt=/utf-8
build:windows --host_cxxopt=/utf-8
build:windows --cxxopt=/permissive-
build:windows --host_cxxopt=/permissive-
build:windows --cxxopt=/DNOMINMAX
build:windows --cxxopt=/D_CRT_SECURE_NO_WARNINGS
build:windows --host_cxxopt=/DNOMINMAX
build:windows --host_cxxopt=/D_CRT_SECURE_NO_WARNINGS
build:windows --compiler=msvc-cl

# 3. Core C++ library (:geometry) compiles with -fno-exceptions -fno-rtti via
#    NO_EXCEPTIONS_COPTS in BUILD.bazel, whereas pybind11 bindings (bindings.cc)
#    require C++ exceptions/RTTI to translate errors cleanly into Python.
build:macos --per_file_copt=bindings\.cc$@-fexceptions,-frtti
build:linux --per_file_copt=bindings\.cc$@-fexceptions,-frtti
build:windows --per_file_copt=bindings\.cc$@/EHsc,/GR,/U_HAS_EXCEPTIONS

try-import %workspace%/.bazelrc.user
