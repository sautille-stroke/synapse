load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")

COMMON_COPTS = select({
    "@platforms//os:windows": [
        "/std:c++20",
        "/W4",
    ],
    "//conditions:default": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
})

NO_EXCEPTIONS_COPTS = select({
    "@platforms//os:windows": [
        "/EHs-c-",
        "/GR-",
        "/D_HAS_EXCEPTIONS=0",
    ],
    "//conditions:default": [
        "-fno-exceptions",
        "-fno-rtti",
    ],
})

cc_library(
    name = "geometry",
    srcs = ["src/mesh_checks.cc"],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    copts = COMMON_COPTS + NO_EXCEPTIONS_COPTS,
    deps = [
        "@aether//math",
    ],
    visibility = ["//visibility:public"],
)

pybind_extension(
    name = "_c_geometry",
    srcs = ["src/bindings.cc"],
    copts = COMMON_COPTS,
    deps = [
        ":geometry",
    ],
    visibility = ["//visibility:public"],
)
