load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

COMMON_COPTS = select({
    "@platforms//os:windows": [
        "/std:c++20",
        "/Zc:__cplusplus",
        "/utf-8",
        "/W4",
    ],
    "//conditions:default": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
})

NO_EXCEPTIONS_COPTS = select({
    "@platforms//os:windows": [
        "/EHs-c-",
        "/GR-",
        "/D_HAS_EXCEPTIONS=0",
    ],
    "//conditions:default": [
        "-fno-exceptions",
        "-fno-rtti",
    ],
})

cc_library(
    name = "geometry",
    srcs = ["src/mesh_checks.cc"],
    hdrs = glob(["include/**/*.h"]),
    copts = COMMON_COPTS + NO_EXCEPTIONS_COPTS,
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@aether//math",
    ],
)

pybind_extension(
    name = "_c_geometry",
    srcs = ["src/bindings.cc"],
    copts = COMMON_COPTS,
    visibility = ["//visibility:public"],
    deps = [
        ":geometry",
    ],
)

cc_test(
    name = "test_geometry",
    size = "small",
    srcs = ["tests/test_geometry.cc"],
    copts = COMMON_COPTS + NO_EXCEPTIONS_COPTS,
    deps = [
        ":geometry",
    ],
)
