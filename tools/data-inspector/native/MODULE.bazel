"""Data Inspector native rendering subprocess.

Standalone Bazel module for the Synapse Data Inspector's C++20 native
rendering process. Depends on @aether (PAL shared-memory, core types)
via local_path_override.
"""

module(
    name = "data-inspector-native",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aether", version = "0.3.0")

local_path_override(
    module_name = "aether",
    path = "../../../../aether",
)
