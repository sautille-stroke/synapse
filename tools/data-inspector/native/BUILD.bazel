load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

COMMON_COPTS = select({
    "@platforms//os:windows": [
        "/W4",
    ],
    "//conditions:default": [
        "-Wall",
        "-Wextra",
    ],
})

cc_library(
    name = "inspector_lib",
    srcs = [
        "inspector_app.cc",
        "inspector_shm_server.cc",
    ],
    hdrs = [
        "inspector_app.h",
        "inspector_shm_server.h",
    ],
    copts = COMMON_COPTS,
    linkopts = select({
        "@platforms//os:windows": [],
        "@platforms//os:macos": ["-framework", "Foundation"],
        "//conditions:default": ["-lpthread", "-lrt"],
    }),
    deps = [
        "@aether//core",
        "@aether//fs",
        "@aether//io",
        "@aether//json",
        "@aether//pal:console",
        "@aether//pal:shm",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "data-inspector-native",
    srcs = ["main.cc"],
    copts = COMMON_COPTS,
    deps = [
        ":inspector_lib",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "test_inspector",
    size = "small",
    srcs = ["test_inspector.cc"],
    copts = COMMON_COPTS,
    deps = [
        ":inspector_lib",
        "@aether//fs",
        "@googletest//:gtest_main",
    ],
)
