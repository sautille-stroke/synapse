load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

COMMON_COPTS = select({
    "@platforms//os:windows": [
        "/std:c++20",
        "/W4",
        "/EHs-c-",
        "/GR-",
        "/D_HAS_EXCEPTIONS=0",
    ],
    "//conditions:default": [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fno-exceptions",
        "-fno-rtti",
    ],
})

cc_library(
    name = "inspector_lib",
    srcs = [
        "inspector_app.cc",
        "inspector_shm_server.cc",
    ],
    hdrs = [
        "inspector_app.h",
        "inspector_shm_server.h",
    ],
    copts = COMMON_COPTS,
    linkopts = select({
        "@platforms//os:windows": [],
        "@platforms//os:macos": ["-framework", "Foundation"],
        "//conditions:default": ["-lpthread", "-lrt"],
    }),
    deps = [
        "@aether//core",
        "@aether//pal:shm",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "data-inspector-native",
    srcs = ["main.cc"],
    copts = COMMON_COPTS,
    deps = [
        ":inspector_lib",
    ],
    visibility = ["//visibility:public"],
)
