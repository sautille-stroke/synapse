{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.dervgen.dev/schemas/job_bundle.v1.0.schema.json",
  "title": "Synapse JobBundle Manifest v1.0",
  "description": "RFC 0039 Job Bundle manifest describing a single stateless stage execution. Mirrors python/synapse/pipeline/bundle_worker.py::BundleManifest. Also accepts the render-farm/grand-studio upstream wire format via BundleManifest.from_rfc0039_job_bundle() when 'closure_type' is present.",
  "type": "object",
  "oneOf": [
    {
      "title": "Synapse Native Format",
      "required": ["schema_version", "job_id", "stage"],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "synapse.job_bundle.v1.0",
          "description": "Wire-format version identifier."
        },
        "job_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique job identifier from the upstream scheduler."
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "description": "Registered stage name to execute (e.g. 'fgpp_validate', 'neural_video_generate', 'delight_albedo')."
        },
        "inputs": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "description": "Mapping of logical input names to file paths / URIs."
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "description": "Mapping of logical output names to file paths / URIs."
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "default": {},
          "description": "Stage-specific parameter overrides."
        },
        "hardware_budget": {
          "$ref": "#/$defs/HardwareBudget"
        },
        "traceparent": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "default": null,
          "description": "Optional W3C traceparent header value."
        },
        "tracestate": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional W3C tracestate header value."
        }
      }
    },
    {
      "title": "RFC 0039 Upstream Format (render-farm / grand-studio)",
      "description": "Upstream JobBundle format with closure_type. Automatically routed through BundleManifest.from_rfc0039_job_bundle().",
      "required": ["job_id", "closure_type"],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique job identifier from the upstream scheduler."
        },
        "project_name": {
          "type": "string",
          "description": "Project name from the upstream scheduler."
        },
        "closure_type": {
          "type": "string",
          "enum": ["neural_video", "surgical_inpaint", "mesh_reconstruct", "optical_polish", "mocap_ik", "delighting"],
          "description": "RFC 0039 closure type mapped to synapse stage names."
        },
        "engine": {
          "$ref": "#/$defs/EngineSpec"
        },
        "scene_spec": {
          "$ref": "#/$defs/SceneSpec"
        },
        "asset_manifest": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetManifestEntry"
          },
          "description": "List of input asset files with SHA-256 checksums."
        },
        "output_sink": {
          "$ref": "#/$defs/OutputSink"
        },
        "payload": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "description": "Stage-specific parameters (may be null)."
        },
        "hardware_budget": {
          "$ref": "#/$defs/HardwareBudget"
        },
        "input_sha256s": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Mapping of input keys to expected SHA-256 hex digests."
        },
        "traceparent": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "default": null,
          "description": "Optional W3C traceparent header value."
        }
      }
    }
  ],
  "$defs": {
    "HardwareBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "free_vram_gb": {
          "type": "number",
          "minimum": 0,
          "default": 24.0,
          "description": "Available GPU VRAM in GiB."
        },
        "max_cpu_cores": {
          "type": "integer",
          "minimum": 1,
          "default": 8,
          "description": "Maximum CPU cores the worker may use."
        }
      },
      "description": "Hardware resource budget for a single job execution."
    },
    "EngineSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Engine name (e.g. 'fulgur', 'caelum')." },
        "version": { "type": "string", "description": "Engine version string." },
        "mode": { "type": "string", "description": "Execution mode (e.g. 'realtime', 'offline')." }
      },
      "description": "Upstream engine specification."
    },
    "SceneSpec": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2,
          "description": "[width, height] pixel dimensions."
        },
        "frame_range": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2,
          "description": "[start, end] frame indices (inclusive)."
        },
        "frameRange": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 2,
          "maxItems": 2,
          "description": "camelCase alias for frame_range."
        },
        "camera": {
          "description": "Camera identifier or parameters."
        },
        "crop_window": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x0, y0, x1, y1] normalised crop region."
        },
        "cropWindow": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "camelCase alias for crop_window."
        },
        "target_crypto_ids": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Cryptomatte entity IDs to focus on."
        },
        "targetCryptoIds": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "camelCase alias for target_crypto_ids."
        }
      },
      "additionalProperties": true,
      "description": "Scene specification from the upstream scheduler."
    },
    "OutputSink": {
      "type": "object",
      "properties": {
        "format": { "type": "string", "description": "Output format (e.g. 'mp4', 'exr', 'npy')." },
        "channels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Requested output channels."
        },
        "write_capability": { "type": "string", "description": "Where output is written." }
      },
      "additionalProperties": true,
      "description": "Output sink specification."
    },
    "AssetManifestEntry": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "File path to the asset." },
        "logical_path": { "type": "string", "description": "Logical path alias (alternative to 'path')." },
        "sha256": { "type": "string", "description": "Expected SHA-256 hex digest." },
        "size_bytes": { "type": "integer", "minimum": 0, "description": "File size in bytes." },
        "payload": { "description": "Optional payload (may be null)." }
      },
      "description": "Asset manifest entry with optional SHA-256 checksum."
    }
  }
}
