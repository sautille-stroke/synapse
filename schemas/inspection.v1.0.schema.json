{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.dervgen.dev/schemas/inspection.v1.0.schema.json",
  "title": "Synapse InspectionReport v2.0",
  "description": "3D asset quality inspection report schema. Mirrors python/synapse/inspect/schemas.py::InspectionReport.",
  "type": "object",
  "required": ["asset_id", "asset_name", "inspection_timestamp", "overall_quality_score"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0",
      "default": "2.0.0",
      "description": "Report schema version string."
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the inspected asset."
    },
    "asset_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable asset name."
    },
    "inspection_timestamp": {
      "type": "string",
      "description": "ISO-8601 timestamp of the inspection run."
    },
    "overall_quality_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Aggregate quality score in [0, 1]."
    },
    "defects": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/DefectAnnotation3D"
      },
      "description": "List of detected defect annotations."
    },
    "requires_hitl": {
      "type": "boolean",
      "default": false,
      "description": "Whether the asset requires human-in-the-loop review."
    },
    "camera_poses_evaluated": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CameraPose"
      },
      "description": "Camera poses used during the inspection sweep."
    },
    "metrics_summary": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "default": {},
      "description": "Key-value summary of computed quality metrics."
    }
  },
  "$defs": {
    "CameraPose": {
      "type": "object",
      "required": ["position", "rotation", "fov_deg"],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "3D world-space camera position [x, y, z]."
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 9,
          "description": "Rotation as 9-element column-major 3x3 matrix or 4-element quaternion [x, y, z, w]."
        },
        "fov_deg": {
          "type": "number",
          "exclusiveMinimum": 0.0,
          "maximum": 180.0,
          "description": "Vertical field of view in degrees."
        },
        "resolution": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "minItems": 2,
          "maxItems": 2,
          "default": [512, 512],
          "description": "Output image resolution [width, height]."
        }
      }
    },
    "DefectAnnotation3D": {
      "type": "object",
      "required": ["defect_id", "category", "severity", "confidence", "center_3d", "bounding_radius_m", "affected_vertices_count"],
      "additionalProperties": false,
      "properties": {
        "defect_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique identifier for this defect instance."
        },
        "category": {
          "type": "string",
          "enum": [
            "mesh_crumple",
            "texture_stretch",
            "seam_tearing",
            "floating_debris",
            "anatomical_distortion",
            "plastic_shading"
          ],
          "description": "Defect taxonomy category."
        },
        "severity": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Severity score in [0, 1]."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Detection confidence in [0, 1]."
        },
        "center_3d": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3,
          "description": "3D world position of the defect centre [x, y, z]."
        },
        "bounding_radius_m": {
          "type": "number",
          "minimum": 0.0,
          "description": "Approximate bounding sphere radius in metres."
        },
        "affected_vertices_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of mesh vertices affected by this defect."
        },
        "macro_camera": {
          "oneOf": [
            { "$ref": "#/$defs/CameraPose" },
            { "type": "null" }
          ],
          "default": null,
          "description": "Optional close-up camera pose for macro inspection."
        },
        "macro_crop_uri": {
          "type": ["string", "null"],
          "default": null,
          "description": "Optional URI to a cropped macro image of the defect."
        },
        "suggested_action": {
          "type": "string",
          "enum": ["auto_remesh", "auto_inpaint_texture", "manual_hitl", "accept"],
          "default": "accept",
          "description": "Recommended remediation action."
        }
      }
    }
  }
}
