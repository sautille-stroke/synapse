# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions & Bazel symlinks & locks
*.so
*.pyd
*.dylib
**/bazel-*
**/MODULE.bazel.lock

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE & editors
.vscode/
.idea/
*.swp
*.swo

# Testing & coverage
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# Local data & temp
data/cache/
data/downloads/
output/
tmp/
data/datasets/
data/benchmarks/
data/golden_datasets/

# L-Asset external cache & archives (RFC 0062)
assets/*/
!assets/models/**

# Synapse-generated session data
data/sessions/

# Node.js (data-inspector)
node_modules/
**/node_modules/

# Mypy cache
.mypy_cache/

# Ruff cache
.ruff_cache/

# uv lock (local-only, not version-tracked per pyproject.toml strategy)
uv.lock

# Evaluation output
eval_output/


# OS-specific metadata
.DS_Store
Thumbs.db
desktop.ini

# Per-user Bazel config
.bazelrc.user
